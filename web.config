<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for Conetix Plesk (Windows) hosting.

  This file is the Windows/IIS equivalent of the _redirects and _headers files
  (which are only read by Netlify and Cloudflare Pages). On Conetix, THIS is the
  file that does the work. Do not delete it.

  It does four things:
    1. 301-redirects the old Umbraco URLs to the new pages
    2. Forces https:// and the www. hostname
    3. Sends the security headers the old site was missing
    4. Serves 404.html for missing pages, and caches assets for a year
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Old Umbraco URLs -> new pages. Keeps existing links and search rankings alive. -->
        <rule name="old-about" stopProcessing="true">
          <match url="^about/?$" />
          <action type="Redirect" url="/team.html" redirectType="Permanent" />
        </rule>
        <rule name="old-services" stopProcessing="true">
          <match url="^services/?$" />
          <action type="Redirect" url="/services.html" redirectType="Permanent" />
        </rule>
        <rule name="old-insights" stopProcessing="true">
          <match url="^market-insights/?$" />
          <action type="Redirect" url="/insights/" redirectType="Permanent" />
        </rule>
        <rule name="old-contact" stopProcessing="true">
          <match url="^contact/?$" />
          <action type="Redirect" url="/contact.html" redirectType="Permanent" />
        </rule>
        <rule name="old-umbraco" stopProcessing="true">
          <match url="^umbraco(/.*)?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- Force https -->
        <rule name="force-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://www.hilvert.com.au/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Force the www hostname so there is only ever one canonical address -->
        <rule name="force-www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^hilvert\.com\.au$" />
          </conditions>
          <action type="Redirect" url="https://www.hilvert.com.au/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://formspree.io; form-action https://formspree.io; frame-ancestors 'self'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>
